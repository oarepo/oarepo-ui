{#def identifier=None, creatibutorName=None, fallbackImage="/static/images/square-placeholder.png" #}
{% if identifier %}
    {% set scheme = identifier.scheme or "" %}
    {% set value = identifier.identifier or "" %}
    {% set link = identifier.url %}
    {# Without a scheme there is no icon to resolve, thus fall back to a generic placeholder #}
    {% if scheme %}
      {% set icon = "/static/images/{}.svg".format(scheme.lower()) %}
      {% set alt = "{} logo".format(scheme) %}
      {% set badgeTitle = (creatibutorName or "") + " " + scheme + ": " + value %}
    {% else %}
      {% set icon = fallbackImage %}
      {% set alt = "Identifier logo" %}
      {% set badgeTitle = (creatibutorName or "") + " " + value %}
    {% endif %}

  {% if link %}
  <a
    class="no-text-decoration mr-0"
    href="{{ link }}"
    aria-label="{{ badgeTitle }}"
    title="{{ badgeTitle }}"
    key="{{ link }}"
    rel="noopener noreferrer"
    target="_blank"
  >
    <img
      class="inline-id-icon identifier-badge"
      src="{{ icon }}"
      alt="{{ alt }}"
      onerror="this.onerror=null; this.src='{{fallbackImage}}';"
    />
  </a>
{% else %}
  <img
    title="{{ badgeTitle }}"
    class="inline-id-icon identifier-badge"
    src="{{ icon }}"
    alt="{{ alt }}"
    onerror="this.onerror=null; this.src='{{fallbackImage}}';"
  />
{% endif %}
{% endif %}
