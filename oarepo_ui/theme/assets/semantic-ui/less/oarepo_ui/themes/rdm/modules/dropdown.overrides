.ui.dropdown {
  &.datepicker-dropdown {
    .menu {
      box-shadow: none;
    }
  }
}

@media all and (max-width: @tabletBreakpoint) {
  .ui.dropdown {
    min-width: 0 !important;
  }
}

/* CLDR names some languages in lower case ("čeština") */
.lang-select .ui.dropdown {
  > .text::first-letter,
  .menu > .item::first-letter {
    text-transform: uppercase;
  }
}
