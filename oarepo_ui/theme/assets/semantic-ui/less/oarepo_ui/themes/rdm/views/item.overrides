.ui.items > .item.license-item {
  cursor: pointer !important;
  line-height: 1;
  @media screen and (max-width: @largestMobileScreen) {
    flex-direction: row;
  }

  .radio {
    margin-right: 0.5em;
  }

  .content.license-item-content {
    .description.license-item-description {
      font-size: smaller;
      color: rgba(0, 0, 0, 0.6);
    }
  }
}
// for license field, otherwise, if your line-height is different than 1,
// radio button is not aligned with item title
.ui.items {
  .item {
    &.license-item {
      .content.license-item-content {
        .ui.header {
          line-height: 1 !important;
        }
      }
    }
  }
}
.item div.description:not(.license-item-description) {
  display: initial !important;
}

.ui.modal {
  .item.deposit-drag-listitem {
    .content {
      width: auto !important;
    }
    .right.floated.content {
      padding: 0;
    }
  }
}
